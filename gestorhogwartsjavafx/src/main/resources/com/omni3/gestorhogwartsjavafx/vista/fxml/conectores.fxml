<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="pantalla" styleClass="pantalla" spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omni3.gestorhogwartsjavafx.controlador.ConectoresController"
      stylesheets="@../css/tema.css">

  <HBox alignment="CENTER_LEFT" spacing="12">
    <Label text="Conectores" styleClass="titulo-seccion"/>
    <Label text="Fuentes del entorno y su estado" styleClass="texto-secundario"/>
    <Region HBox.hgrow="ALWAYS"/>
    <ProgressIndicator fx:id="indicadorCarga" prefWidth="18" prefHeight="18" maxHeight="18" visible="false"/>
    <Button fx:id="botonRefrescar" text="Refrescar" styleClass="boton-secundario" onAction="#cargar"/>
  </HBox>

  <StackPane VBox.vgrow="ALWAYS">
    <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="colOrigen" text="Fuente" prefWidth="150"/>
        <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
        <TableColumn fx:id="colMensaje" text="Detalle" prefWidth="320"/>
        <TableColumn fx:id="colSincronizacion" text="Última sincronización" prefWidth="200"/>
      </columns>
      <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>

    <VBox fx:id="capaVacio" alignment="CENTER" spacing="8" visible="false">
      <Label fx:id="textoVacio" text="Sin resultados" styleClass="texto-vacio"/>
    </VBox>
  </StackPane>

  <HBox alignment="CENTER_LEFT" spacing="16">
    <Label fx:id="etiquetaConteo" text="0 conectores" styleClass="texto-secundario"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="etiquetaMensaje" text="" styleClass="texto-secundario"/>
  </HBox>
</VBox>
