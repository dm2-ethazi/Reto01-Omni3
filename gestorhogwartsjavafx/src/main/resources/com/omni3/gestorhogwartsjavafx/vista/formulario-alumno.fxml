<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="formulario" styleClass="formulario" spacing="8" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omni3.gestorhogwartsjavafx.controlador.FormularioAlumnoController">

  <Label fx:id="tituloFormulario" text="Nuevo alumno" styleClass="titulo-seccion"/>
  <Label fx:id="textoAyuda" text="Los alumnos nuevos se crean en la central MariaDB."
         styleClass="texto-secundario" wrapText="true"/>

  <GridPane hgap="12" vgap="6">
    <columnConstraints>
      <ColumnConstraints minWidth="110"/>
      <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
    </columnConstraints>

    <Label text="DNI *" styleClass="etiqueta-campo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="campoDni" promptText="12345678A" styleClass="campo"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label fx:id="errorDni" text="" styleClass="texto-error"
           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Nombre *" styleClass="etiqueta-campo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="campoNombre" promptText="Nombre y apellidos" styleClass="campo"
               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label fx:id="errorNombre" text="" styleClass="texto-error"
           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Casa" styleClass="etiqueta-campo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="comboCasa" promptText="Sin casa (alumno nuevo)" styleClass="campo-combo"
              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Label fx:id="errorCasa" text="" styleClass="texto-error"
           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Patronus *" styleClass="etiqueta-campo" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="campoPatronus" promptText="Ej. Ciervo" styleClass="campo"
               GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    <Label fx:id="errorPatronus" text="" styleClass="texto-error"
           GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label text="Origen" styleClass="etiqueta-campo" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <Label fx:id="campoOrigen" text="—" styleClass="valor-dato"
           GridPane.rowIndex="8" GridPane.columnIndex="1"/>

    <Label text="Versión" styleClass="etiqueta-campo" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <Label fx:id="campoVersion" text="—" styleClass="valor-dato"
           GridPane.rowIndex="9" GridPane.columnIndex="1"/>
  </GridPane>

  <Label fx:id="etiquetaResultado" text="" wrapText="true" styleClass="texto-secundario"/>
  <Label fx:id="etiquetaRequestId" text="" wrapText="true" styleClass="texto-secundario"/>

  <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
</VBox>
