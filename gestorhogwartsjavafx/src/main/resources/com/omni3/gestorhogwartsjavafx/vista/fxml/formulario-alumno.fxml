<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="formulario" styleClass="formulario" spacing="8" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omni3.gestorhogwartsjavafx.controlador.FormularioAlumnoController"
      stylesheets="@../css/tema.css">

  <Label fx:id="tituloFormulario" text="%form.titulo.nuevo" styleClass="titulo-seccion"/>
  <Label fx:id="textoAyuda" text="%form.ayuda.nuevo.fxml"
         styleClass="texto-secundario" wrapText="true" maxWidth="Infinity"/>

  <GridPane hgap="12" vgap="6">
    <columnConstraints>
      <ColumnConstraints minWidth="110"/>
      <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
    </columnConstraints>

    <Label text="DNI *" styleClass="etiqueta-campo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="campoDni" promptText="12345678A" styleClass="campo"
               maxWidth="Infinity" GridPane.hgrow="ALWAYS"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label fx:id="errorDni" text="" styleClass="texto-error"
           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="%form.campo.nombre" styleClass="etiqueta-campo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="campoNombre" promptText="%form.prompt.nombre" styleClass="campo"
               maxWidth="Infinity" GridPane.hgrow="ALWAYS"
               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label fx:id="errorNombre" text="" styleClass="texto-error"
           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="%form.campo.casa" styleClass="etiqueta-campo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="comboCasa" promptText="%form.prompt.casa" styleClass="campo-combo"
              maxWidth="Infinity" GridPane.hgrow="ALWAYS"
              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Label fx:id="errorCasa" text="" styleClass="texto-error"
           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="%form.campo.patronus" styleClass="etiqueta-campo" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <HBox spacing="8" alignment="CENTER_LEFT" maxWidth="Infinity" GridPane.hgrow="ALWAYS"
          GridPane.rowIndex="6" GridPane.columnIndex="1">
      <ComboBox fx:id="comboPatronus" promptText="%form.prompt.patronus" styleClass="campo-combo"
                editable="true" HBox.hgrow="ALWAYS"/>
      <ImageView fx:id="imagenPatronus" fitWidth="40" fitHeight="40" preserveRatio="true"
                 visible="false"/>
    </HBox>
    <Label fx:id="errorPatronus" text="" styleClass="texto-error"
           GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label text="%form.campo.origen" styleClass="etiqueta-campo" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <Label fx:id="campoOrigen" text="—" styleClass="valor-dato"
           GridPane.rowIndex="8" GridPane.columnIndex="1"/>

    <Label text="%form.campo.version" styleClass="etiqueta-campo" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <Label fx:id="campoVersion" text="—" styleClass="valor-dato"
           GridPane.rowIndex="9" GridPane.columnIndex="1"/>
  </GridPane>

  <Label fx:id="etiquetaResultado" text="" wrapText="true" maxWidth="Infinity" styleClass="texto-secundario"/>
  <Label fx:id="etiquetaRequestId" text="" wrapText="true" maxWidth="Infinity" styleClass="texto-secundario"/>

  <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
</VBox>
