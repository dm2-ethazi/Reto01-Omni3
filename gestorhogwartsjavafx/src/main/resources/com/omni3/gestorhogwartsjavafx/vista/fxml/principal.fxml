<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" styleClass="raiz" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omni3.gestorhogwartsjavafx.controlador.PrincipalController"
      stylesheets="@../css/tema.css">

  <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cabecera">
    <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
    <ImageView fx:id="iconoCabecera" fitWidth="28" fitHeight="28" preserveRatio="true"/>
    <Label text="Gestor Hogwarts" styleClass="titulo-cabecera"/>
    <Label text="Cliente de escritorio" styleClass="subtitulo-cabecera"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="botonSalud" text="Estado del sistema" styleClass="boton-secundario" onAction="#comprobarSalud">
      <tooltip><Tooltip text="Vuelve a consultar la API y muestra el estado de la conexión y de las bases de datos"/></tooltip>
    </Button>
  </HBox>

  <HBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="cuerpo">
    <VBox fx:id="lateral" prefWidth="230" spacing="6" styleClass="lateral">
      <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
      <Label text="NAVEGACIÓN" styleClass="etiqueta-seccion"/>
      <Button fx:id="navEstado" text="Estado del sistema" maxWidth="Infinity" styleClass="boton-lateral"
              onAction="#navegarEstado">
        <tooltip><Tooltip text="Muestra el estado actual de la API y de las bases de datos de las cinco casas"/></tooltip>
      </Button>
      <Button fx:id="navAlumnos" text="Alumnos" maxWidth="Infinity" styleClass="boton-lateral"
              onAction="#navegarAlumnos">
        <tooltip><Tooltip text="Listado de alumnado con búsqueda, alta, edición y baja"/></tooltip>
      </Button>
      <Separator/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="Reto R01 · Omni3" styleClass="texto-secundario"/>
    </VBox>

    <StackPane fx:id="contenedorContenido" styleClass="contenido" HBox.hgrow="ALWAYS">
      <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
      <Label text="Cargando…" styleClass="texto-secundario"/>
    </StackPane>
  </HBox>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-estado">
    <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
    <Label fx:id="estado" text="Listo" styleClass="texto-secundario"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="estadoDerecha" text="JDK 17+ · JavaFX 21" styleClass="texto-secundario"/>
  </HBox>
</VBox>
