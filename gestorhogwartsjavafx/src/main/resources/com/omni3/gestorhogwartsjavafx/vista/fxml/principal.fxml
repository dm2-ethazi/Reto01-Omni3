<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" styleClass="raiz" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omni3.gestorhogwartsjavafx.controlador.PrincipalController"
      stylesheets="@../css/tema.css">

  <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cabecera">
    <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
    <ImageView fx:id="iconoCabecera" fitWidth="28" fitHeight="28" preserveRatio="true"/>
    <Label text="%cabecera.titulo" styleClass="titulo-cabecera"/>
    <Label text="%cabecera.subtitulo" styleClass="subtitulo-cabecera"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="botonSalud" text="%boton.salud" styleClass="boton-secundario" onAction="#comprobarSalud">
      <tooltip><Tooltip text="%tooltip.salud"/></tooltip>
    </Button>
    <!-- Menú de comandos: acciones rápidas de la aplicación (también con F1). -->
    <MenuButton fx:id="botonAyuda" text="%boton.ayuda" mnemonicParsing="true"
                styleClass="boton-secundario">
      <items>
        <CustomMenuItem text="%menu.ayuda.estado" onAction="#navegarEstado">
          <content>
            <Label text="%menu.ayuda.estado" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.menu.ayuda.estado"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
        <CustomMenuItem text="%menu.ayuda.alumnos" onAction="#navegarAlumnos">
          <content>
            <Label text="%menu.ayuda.alumnos" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.menu.ayuda.alumnos"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
        <CustomMenuItem text="%menu.ayuda.comprobar" onAction="#comprobarSalud">
          <content>
            <Label text="%menu.ayuda.comprobar" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.menu.ayuda.comprobar"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
        <CustomMenuItem text="%menu.ayuda.acerca" onAction="#acercaDe">
          <content>
            <Label text="%menu.ayuda.acerca" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.menu.ayuda.acerca"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
      </items>
      <tooltip><Tooltip text="%tooltip.ayuda"/></tooltip>
    </MenuButton>
  </HBox>

  <HBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="cuerpo">
    <VBox fx:id="lateral" prefWidth="230" minWidth="180" spacing="6" styleClass="lateral">
      <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
      <Label text="%nav.seccion" styleClass="etiqueta-seccion"/>
      <Button fx:id="navEstado" text="%boton.salud" maxWidth="Infinity" styleClass="boton-lateral"
              onAction="#navegarEstado">
        <tooltip><Tooltip text="%tooltip.nav.estado"/></tooltip>
      </Button>
      <Button fx:id="navAlumnos" text="%nav.alumnos" maxWidth="Infinity" styleClass="boton-lateral"
              onAction="#navegarAlumnos">
        <tooltip><Tooltip text="%tooltip.nav.alumnos"/></tooltip>
      </Button>
      <Separator/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="%pie.reto" styleClass="texto-secundario"/>
    </VBox>

    <StackPane fx:id="contenedorContenido" styleClass="contenido" HBox.hgrow="ALWAYS">
      <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
      <Label text="%cargando" styleClass="texto-secundario"/>
    </StackPane>
  </HBox>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-estado">
    <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
    <Label fx:id="estado" text="%barra.listo" styleClass="texto-secundario"/>
    <MenuButton fx:id="botonIdioma" text="ES" styleClass="boton-idioma">
      <items>
        <CustomMenuItem text="%menu.idioma.castellano" onAction="#idiomaCastellano">
          <content>
            <Label text="%menu.idioma.castellano" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.idioma.castellano"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
        <CustomMenuItem text="%menu.idioma.euskara" onAction="#idiomaEuskara">
          <content>
            <Label text="%menu.idioma.euskara" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.idioma.euskara"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
        <CustomMenuItem text="%menu.idioma.ingles" onAction="#idiomaIngles">
          <content>
            <Label text="%menu.idioma.ingles" styleClass="comando-menu">
              <tooltip><Tooltip text="%tooltip.idioma.ingles"/></tooltip>
            </Label>
          </content>
        </CustomMenuItem>
      </items>
      <tooltip><Tooltip text="%tooltip.idioma"/></tooltip>
    </MenuButton>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="estadoDerecha" text="%pie.tecnologia" styleClass="texto-secundario"/>
  </HBox>
</VBox>
