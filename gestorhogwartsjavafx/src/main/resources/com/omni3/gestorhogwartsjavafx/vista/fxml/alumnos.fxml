<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="pantalla" styleClass="pantalla" spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omni3.gestorhogwartsjavafx.controlador.AlumnosController"
      stylesheets="@../css/tema.css">

  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="barra-herramientas">
    <Label text="Alumnos" styleClass="titulo-seccion" minWidth="90"/>
    <TextField fx:id="campoBusqueda" promptText="Buscar por DNI o nombre" prefWidth="200"
               minWidth="140" maxWidth="Infinity" HBox.hgrow="ALWAYS"
               styleClass="campo" onAction="#buscar"/>
    <ComboBox fx:id="comboOrigen" prefWidth="180" minWidth="150" styleClass="campo-combo"/>
    <Button fx:id="botonBuscar" text="Buscar" styleClass="boton-secundario" onAction="#buscar"/>
    <Button fx:id="botonLimpiar" text="Limpiar" styleClass="boton-secundario" onAction="#limpiar"/>
    <Button fx:id="botonNuevo" text="Nuevo alumno" styleClass="boton-primario" onAction="#nuevo"/>
    <Button fx:id="botonEditar" text="Editar" styleClass="boton-secundario" onAction="#editar"/>
    <Button fx:id="botonBaja" text="Dar de baja" styleClass="boton-peligro" onAction="#baja"/>
  </HBox>

  <StackPane fx:id="contenedorTabla" VBox.vgrow="ALWAYS">
    <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS"
               columnResizePolicy="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN">
      <columns>
        <TableColumn fx:id="colDni" text="DNI" prefWidth="110"/>
        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="280"/>
        <TableColumn fx:id="colCasa" text="Casa" prefWidth="130"/>
        <TableColumn fx:id="colPatronus" text="Patronus" prefWidth="140"/>
        <TableColumn fx:id="colOrigen" text="Origen" prefWidth="120"/>
      </columns>
      <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>

    <VBox fx:id="capaCarga" alignment="CENTER" spacing="8" styleClass="overlay-carga" visible="false">
      <ProgressIndicator prefWidth="32" prefHeight="32"/>
      <Label fx:id="textoCarga" text="Cargando…" styleClass="texto-secundario"/>
    </VBox>

    <VBox fx:id="capaVacio" alignment="CENTER" spacing="10" visible="false">
      <Label fx:id="textoVacio" text="Sin resultados" styleClass="texto-vacio"/>
      <Button fx:id="botonNuevoVacio" text="Dar de alta un alumno" styleClass="boton-primario"
              onAction="#nuevo"/>
    </VBox>
  </StackPane>

  <HBox alignment="CENTER_LEFT" spacing="16" styleClass="barra-conteo">
    <Label fx:id="etiquetaConteo" text="0 alumnos" styleClass="texto-secundario"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="etiquetaMensaje" text="" styleClass="texto-secundario"/>
    <Label fx:id="etiquetaRequestId" text="" styleClass="texto-secundario"/>
  </HBox>
</VBox>
