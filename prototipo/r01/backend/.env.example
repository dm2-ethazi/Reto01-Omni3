# R01 - Variables de entorno de ejemplo para el backend.
# Copia este fichero a backend/.env y ajusta los valores.
#
# ATENCION: son credenciales de DEMO para los contenedores locales.
# Nunca reutilizarlas en un entorno real ni versionar un .env real.

# --- Conectores (los nombres los fija config/connectors.yaml) -------------
# Apache Derby no autentica por defecto: déjalos vacíos.
DERBY_USER=
DERBY_PASSWORD=

# HSQLDB: el usuario SA con la contraseña fijada en la semilla.
HSQLDB_USER=SA
HSQLDB_PASSWORD=r01pass

# H2: usuario sa creado al primer arranque.
H2_USER=sa
H2_PASSWORD=r01pass

# Oracle Free: usuario de aplicación creado por gvenzl/oracle-free.
ORACLE_USER=r01
ORACLE_PASSWORD_CONN=r01pass

# --- Central doble --------------------------------------------------------
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=r01
MARIADB_PASSWORD=r01pass
MARIADB_DATABASE=central
MARIADB_ENABLED=true

# --- Servidor -------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=dev
LOG_LEVEL=INFO
