pragma layout Smetana

' ============================================================
' R01 - Modelo de datos / clases
' Esquemas Pydantic (API) y entidades de la central
' Render: plantuml -tpng modelo-datos.puml
' ============================================================

@startuml modelo-datos
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle

title **R01 - Modelo de datos**\nEsquemas Pydantic (API) y persistencia de la central

package "app/api/schemas/estudiante.py <<Pydantic v2>>" as sch {

    abstract class EstudianteBase {
        +dni : str  <<12345678Z>>
        +nombre : str [1..100]
        +casa : str [1..30]
        +patronus : str [1..50]
        ..
        #validar_dni()
        #normalizar_nombre()
        +model_config = extra="forbid"
    }

    class EstudianteCreate {
        +id : int|None [ge=1]
    }

    class EstudianteUpdate {
        +dni? : str
        +nombre? : str
        +casa? : str
        +patronus? : str
        ..
        +solo_campos() : dict
    }

    class EstudianteOut {
        +id : int
        +dni : str
        +nombre : str
        +casa : str
        +patronus : str
    }

    class PaginaEstudiantes {
        +items : list<EstudianteOut>
        +total : int
        +offset : int
        +limit : int
        +conector : str
    }

    class EstudianteCentralOut {
        +id : int
        +origen : str  <<trazabilidad>>
        +id_origen : int
        +dni : str
        +nombre : str
        +casa : str
        +patronus : str
        +actualizado : datetime
        +backend : str  <<sqlite|mariadb>>
    }

    class PaginaCentral {
        +items : list<EstudianteCentralOut>
        +total : int
        +offset : int
        +limit : int
        +backend : str
        +filtros : dict
    }

    EstudianteBase <|-- EstudianteCreate
    EstudianteBase <|-- EstudianteOut
    EstudianteCreate o-- PaginaEstudiantes : items
}

package "app/api/schemas/salud.py <<Pydantic v2>>" as salud {
    class HealthResponse {
        +status : str  <<ok|degraded>>
        +reto : str = "R01"
        +central : dict
        +conectores : dict
        +jvm : dict
        +errores : list<str>
    }

    class ConnectorEstado {
        +id : str
        +nombre : str
        +dialect : str
        +url : str
        +disponible : bool
        +detalle : str
    }

    class SyncResumen {
        +conector : str
        +leidos : int
        +insertados : int
        +actualizados : int
        +errores : int
    }

    class BackendEstado {
        +disponible : bool
        +detalle : str
    }
}

package "app/persistence <<central doble>>" as pers {

    class "EstudianteCentral (tabla)" as tabla {
        +id : PK
        +origen : str
        +id_origen : int
        +dni : str
        +nombre : str
        +casa : str
        +patronus : str
        +actualizado : timestamp
        ..
        Clave logica: (origen, id_origen)
    }

    class CompositeCentralRepository {
        +repos : list<Repository>
        +retry_queue : SqliteRetryQueue
        ..
        +buscar(...) : paginada
        +por_dni(dni)
        +upsert(filas) : UpsertResult
        +retry_pending() : stats
        +consistencia()
        +pendientes() : int
    }

    class MariaDbRepository {
        +name = "mariadb"
        +ping() : bool
    }

    class SqliteRepository {
        +name = "sqlite"
        +ping() : bool
    }

    class SqliteRetryQueue {
        +add(operacion)
        +drain() : list
        +count() : int
    }

    CompositeCentralRepository o-- MariaDbRepository
    CompositeCentralRepository o-- SqliteRepository
    CompositeCentralRepository o-- SqliteRetryQueue
    CompositeCentralRepository "1" --> "1" tabla : lee/escribe
}

package "app/services <<transformacion>>" as svc {
    class "transform.py" as transform {
        +normalizar_espacios(v) : str
        +normalizar_dni(v) : str
        +normalizar_nombre(v) : str
        +validar_dni(v) : str
        +transform_row(raw, origen) : dict
        ..
        Reglas: trim, DNI mayusculas,\nnombre<=100, casa<=30,\npatronus<=50, +origen
    }

    class EstudianteCRUDOrigen {
        <<DTO de paso: id, dni, nombre, casa, patronus>>
    }
}

' --- Relaciones entre paquetes
EstudianteCentralOut <-- tabla : fila con trazabilidad
transform ..> tabla : genera filas para upsert
EstudianteUpdate ..> transform : valida igual
PaginaCentral o-- EstudianteCentralOut
PaginaEstudiantes o-- EstudianteOut
HealthResponse o-- ConnectorEstado
HealthResponse o-- BackendEstado

note right of tabla
  La central es de SOLO LECTURA
  via API: la escritura ocurre
  exclusivamente en /sync.
end note

note bottom of CompositeCentralRepository
  Orden de failover:
  MariaDB -> SQLite.
  Fallos de upsert -> retry_queue,
  drenados en el proximo POST /sync.
end note

@enduml
