<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto R01: tarjeta blanca con borde fino y esquinas 12dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/r01_superficie" />
            <stroke android:width="2dp" android:color="@color/r01_acento" />
            <corners android:radius="12dp" />
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/r01_superficie" />
            <stroke android:width="1dp" android:color="@color/r01_borde" />
            <corners android:radius="12dp" />
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
