<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista R01: fondo blanco, separador fino, realce al pulsar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/r01_pulsado" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/r01_primario_claro" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/r01_superficie" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
