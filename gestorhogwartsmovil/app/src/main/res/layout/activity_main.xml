<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: idioma, búsqueda y listado de alumnos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/r01_fondo">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:padding="@dimen/main_header_padding"
        android:background="@drawable/r01_cabecera"
        android:weightSum="1"
        android:baselineAligned="false">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_hogwarts"
            android:textColor="@color/r01_texto_principal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp" />
        <Button
            android:drawableStart="@drawable/baseline_language_24"
            android:id="@+id/botonIdioma"
            style="@style/R01BotonPrimario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/idiomaBoton"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/r01_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/campoNombre"
                android:hint="@string/buscar_hint"
                style="@style/R01Campo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textSize="14sp" />
            <Button
                android:id="@+id/botonBuscar"
                style="@style/R01BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/buscar"
                android:textColor="@color/r01_primario"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoEstado"
            android:background="@drawable/r01_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/estado_inicial"
            android:textColor="@color/r01_primario_oscuro"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        android:background="@drawable/r01_panel"
        android:clipToPadding="false"
        android:padding="4dp"
        android:scrollbars="vertical" />
</LinearLayout>
