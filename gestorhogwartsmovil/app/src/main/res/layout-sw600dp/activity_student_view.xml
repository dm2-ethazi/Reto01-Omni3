<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/r01_fondo">

    <ScrollView
        android:layout_width="@dimen/detail_content_width"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ficha_alumno"
                android:textColor="@color/r01_primario_oscuro"
                android:textSize="@dimen/detail_title_text_size"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imagenAlumno"
                style="@style/R01ImagenAlumno"
                android:contentDescription="@string/imagen_alumno" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/detail_panel_margin_top"
                android:background="@drawable/r01_panel"
                android:orientation="vertical"
                android:padding="@dimen/detail_panel_padding">

                <LinearLayout style="@style/R01FilaDetalle">
                    <LinearLayout style="@style/R01ColumnaDetalle">
                        <TextView style="@style/R01EtiquetaDetalle" android:text="@string/dni" />
                        <TextView android:id="@+id/valorDni" style="@style/R01ValorDetalle" />
                    </LinearLayout>
                    <LinearLayout style="@style/R01ColumnaDetalle">
                        <TextView style="@style/R01EtiquetaDetalle" android:text="@string/nombre_completo" />
                        <TextView android:id="@+id/valorNombre" style="@style/R01ValorDetalle" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/R01FilaDetalle">
                    <LinearLayout style="@style/R01ColumnaDetalle">
                        <TextView style="@style/R01EtiquetaDetalle" android:text="@string/sexo" />
                        <TextView android:id="@+id/valorSexo" style="@style/R01ValorDetalle" />
                    </LinearLayout>
                    <LinearLayout style="@style/R01ColumnaDetalle">
                        <TextView style="@style/R01EtiquetaDetalle" android:text="@string/patronus" />
                        <TextView android:id="@+id/valorPatronus" style="@style/R01ValorDetalle" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/R01FilaDetalle">
                    <LinearLayout style="@style/R01ColumnaDetalle">
                        <TextView style="@style/R01EtiquetaDetalle" android:text="@string/casa" />
                        <TextView android:id="@+id/valorCasa" style="@style/R01ValorDetalle" />
                    </LinearLayout>
                    <Space style="@style/R01ColumnaDetalle" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/botonVolver"
                style="@style/R01BotonPrimario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/volver"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
