# =================================================================== #
#  Configuración de la API Alumnos (Reto 1)                           #
#  Copia este archivo a `.env` y rellena las credenciales reales.     #
# =================================================================== #

# --- General ---------------------------------------------------------- #
# Motores activos, separados por coma. Si quitas uno, la API deja de usarlo.
DB_ENGINES=oracle,mariadb,h2,hsqldb,derby
# Carpeta con los drivers JDBC (.jar). Se resuelve a ruta absoluta.
JARS_DIR=jars

# --- Oracle (casa Ravenclaw) ------------------------------------------ #
ORACLE_HOST=Host_BBDD_Oracle
ORACLE_PORT=Puerto_BBDD_Oracle
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=Usuario_Oracle
ORACLE_PASSWORD=Contraseña_Oracle

# --- MariaDB (casa Hogwarts, base central) ---------------------------- #
MARIADB_HOST=Host_BBDD_MariaDB
MARIADB_PORT=Puerto_BBDD_MariaDB
MARIADB_DATABASE=Nombre_BBDD_MariaDB
MARIADB_USER=Usuario_MariaDB
MARIADB_PASSWORD=Contraseña_MariaDB

# --- H2 (casa Hufflepuff) -------------------------------------------- #
# Ejemplo de URL: jdbc:h2:tcp://localhost:9092/r01db
H2_URL=Ruta_jdbc_H2
H2_USER=Usuario_H2
H2_PASSWORD=Contraseña_H2

# --- HSQLDB (casa Slytherin) ----------------------------------------- #
# Ejemplo de URL: jdbc:hsqldb:hsql://localhost:9001/slytherin
HSQLDB_URL=Ruta_jdbc_HSQLDB
HSQLDB_USER=Usuario_HSQLDB
HSQLDB_PASSWORD=Contraseña_HSQLDB

# --- Derby (casa Gryffindor) ----------------------------------------- #
# Ejemplo de URL: jdbc:derby://localhost:1527/db
DERBY_URL=Ruta_jdbc_derby
DERBY_USER=Usuario_derby
DERBY_PASSWORD=Contraseña_derby
