# Configuración local completa. Igualar credenciales con el .env de la raíz.
DB_ENGINES=oracle,mariadb,h2,hsqldb,derby
JARS_DIR=jars
SQLITE_PATH=data/central.sqlite3
RETRY_INTERVAL_SECONDS=10
REFRESH_QUEUE_MAX=5000
REFRESH_PREPARE_TIMEOUT_SECONDS=30

ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=ravenclaw
# Debe coincidir con ORACLE_USER_PASSWORD del .env raíz.
ORACLE_PASSWORD=example

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=r01_central
MARIADB_USER=r01
MARIADB_PASSWORD=example

H2_URL=jdbc:h2:tcp://127.0.0.1:9092/r01db
H2_USER=sa
H2_PASSWORD=
HSQLDB_URL=jdbc:hsqldb:hsql://127.0.0.1:9001/slytherin
HSQLDB_USER=SA
HSQLDB_PASSWORD=
DERBY_URL=jdbc:derby://127.0.0.1:1527/db
DERBY_USER=
DERBY_PASSWORD=
