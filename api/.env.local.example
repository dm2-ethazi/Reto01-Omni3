# Local demo: match credentials to the root .env before starting the API.
DB_ENGINES=mariadb
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=r01_central
MARIADB_USER=example
MARIADB_PASSWORD=example

# SQLite de respaldo (dentro de api/, en un volumen si usas Docker Compose).
SQLITE_PATH=data/respaldo.db

# Reintentos de sincronización con MariaDB.
SYNC_INTERVALO_SEGUNDOS=5
SYNC_BACKOFF_INICIAL_SEGUNDOS=2
SYNC_BACKOFF_MAX_SEGUNDOS=60
SYNC_MAX_INTENTOS=8
