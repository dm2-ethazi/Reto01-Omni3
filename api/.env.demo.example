# Plantilla de demo aislada para scripts/start-local.ps1.
# Copiar a api/data/validation.env y cambiar las contrasenas antes de arrancar.
# Este archivo compartido configura Compose y las variables de entorno de la API.
# En esta demo ORACLE_PASSWORD y ORACLE_USER_PASSWORD deben ser iguales:
# el primero se usa tambien como clave del usuario Oracle desde la API.
DB_ENGINES=oracle,mariadb,h2,hsqldb,derby
JARS_DIR=jars
SQLITE_PATH=data/validation-final.sqlite3
RETRY_INTERVAL_SECONDS=10
REFRESH_QUEUE_MAX=5000
REFRESH_PREPARE_TIMEOUT_SECONDS=30

MARIADB_ROOT_PASSWORD=change-demo-root
MARIADB_HOST=127.0.0.1
MARIADB_PORT=33306
MARIADB_DATABASE=r01_central
MARIADB_USER=r01
MARIADB_PASSWORD=change-demo-maria

ORACLE_HOST=127.0.0.1
ORACLE_PORT=31521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=ravenclaw
ORACLE_PASSWORD=change-demo-oracle
ORACLE_USER_PASSWORD=change-demo-oracle

H2_PORT=39092
H2_WEB_PORT=38082
H2_URL=jdbc:h2:tcp://127.0.0.1:39092/r01db
H2_USER=sa
H2_PASSWORD=
HSQLDB_PORT=39001
HSQLDB_URL=jdbc:hsqldb:hsql://127.0.0.1:39001/slytherin
HSQLDB_USER=SA
HSQLDB_PASSWORD=
DERBY_PORT=31527
DERBY_URL=jdbc:derby://127.0.0.1:31527/db
DERBY_USER=
DERBY_PASSWORD=
